# Host interface and port for the web UI. Keep 127.0.0.1 behind a TLS reverse proxy;
# 0.0.0.0 exposes plain HTTP on all interfaces (only for trusted networks).
BIND_ADDRESS=127.0.0.1
PORT=8080
# Allow registrations after the first account (the first account can always register)
ALLOW_REGISTRATION=false
# Set to true when served via HTTPS (e.g. behind a TLS reverse proxy)
COOKIE_SECURE=false
LOG_LEVEL=info
# Expose Prometheus metrics at /api/metrics inside the backend container (never via nginx)
METRICS_ENABLED=false
# Contact sent to push services with Web Push (VAPID); use a real address
PUSH_SUBJECT=mailto:admin@localhost
# Attachments in S3-compatible storage instead of the data volume (see docs/operations/deployment.md)
ATTACHMENT_STORAGE=volume
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=notizen
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
